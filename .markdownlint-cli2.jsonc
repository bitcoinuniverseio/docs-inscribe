{
  // Markdown lint for prose that also renders through Starlight.
  "config": {
    "default": true,
    // Line length is not enforced: chain literals, tables, and URLs make a
    // hard wrap counterproductive, and Prettier-style reflow is not used.
    "MD013": false,
    // Starlight supplies the H1 from frontmatter; body headings start at H2.
    "MD025": false,
    "MD041": false,
    // Inline HTML is used deliberately in the README (logo alignment) and
    // in MDX pages (components).
    "MD033": false,
    // Duplicate sibling headings never occur; duplicate headings across
    // sections (e.g. "Related") are intended structure.
    "MD024": { "siblings_only": true },
    // Bare URLs inside code fences are examples, not links.
    "MD034": false
  },
  "ignores": ["node_modules", "dist", ".astro"]
}
