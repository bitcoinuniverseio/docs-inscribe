{
  "name": "docs-inscribe",
  "version": "1.0.0",
  "private": true,
  "description": "Public documentation for Universe Inscribe, the Bitcoin Universe creation studio",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:copy": "node scripts/check-copy-rules.mjs",
    "check:public-safety": "node scripts/check-public-safety.mjs",
    "check:capabilities": "node scripts/check-capability-truth.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:markdown": "markdownlint-cli2 \"src/content/docs/**/*.{md,mdx}\" \"*.md\"",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "test": "npm run check:copy && npm run check:public-safety && npm run check:capabilities && npm run check:manifest && npm run check:markdown"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "^0.41.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^7.2.9",
    "sharp": "^0.35.4",
    "starlight-links-validator": "^0.25.3"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.1",
    "wait-on": "^9.1.0"
  }
}
